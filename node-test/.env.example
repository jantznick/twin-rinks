# Copy to `.env` in this directory before `docker compose up`.
# Prisma and PostgreSQL are intended to run only via Docker (see docker-compose.yml).

PORT=3001
LEGACY_BASE_URL=https://hockeydomain.com/adulthockey/subs
LEGACY_LOGIN_PATH=/subs_entry.php
LEGACY_GAMES_PATH=/all_player_login.php
LEGACY_SUBMIT_PATH=/cgi-bin/bnbform.cgi
BODY_PREVIEW_LIMIT=4000
LOG_SENSITIVE=0
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# Cookie sessions
SESSION_SECRET=change-me-to-a-long-random-string
# COOKIE_DOMAIN=.example.com

# Resend (optional in development — links print to the API console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Twin Rinks <onboarding@resend.dev>

# AES-256 key for encrypting linked Twin Rinks legacy passwords (32-byte hex or any passphrase)
LEGACY_CREDENTIALS_KEY=dev-legacy-credentials-key-change-me

# DATABASE_URL=postgresql://twinrinks:twinrinks@db:5432/twin_rinks?schema=public
