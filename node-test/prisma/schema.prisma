generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Twin Rinks app user: first-party auth + preferences.
/// Legacy Twin Rinks credentials (optional) are stored encrypted for server-side PHPSESSID.
model User {
  id                            String                 @id @default(cuid())
  email                         String                 @unique
  passwordHash                  String?
  emailVerified                 Boolean                @default(false)
  /// Legacy Twin Rinks subs username (plaintext OK; password is encrypted separately).
  twinRinksUsername             String?
  twinRinksPasswordEnc          String?
  twinRinksPhpsessid            String?
  twinRinksSessionUpdatedAt     DateTime?
  twinRinksLinkedAt             DateTime?
  sportsengineCalendars         Json                   @default("[]")
  /// Sub submit: warn if requesting a sub while already playing another game that calendar day.
  subWarnIfSameDayGame          Boolean                @default(false)
  /// Sub submit: warn if requesting a sub while having a game the previous or next calendar day.
  subWarnIfAdjacentGameDays     Boolean                @default(false)
  /// Season calendar: league name matching `seasonCalendar.json` (e.g. "Platinum").
  twinRinksSeasonLeague         String?
  /// Season calendar: team name matching `seasonCalendar.json` home/away (e.g. "Kelly").
  twinRinksSeasonTeam           String?
  blackoutRules                 BlackoutRule[]
  calendarSubscriptions         CalendarSubscription[]
  authTokens                    AuthToken[]
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
}

/// express-session / connect-pg-simple store
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

/// One-time auth tokens (magic link, password reset, email verification).
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(500)
  /// magic_link | password_reset | email_verification
  tokenType String    @db.VarChar(32)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("auth_tokens")
}

/// Imported calendar feed (Google / iCal). Mode IMPORT_ALL syncs every event in-window; IMPORT_PICK stores user-selected instances only.
model CalendarSubscription {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  label         String?
  mode          String
  leagueScopes  Json                     @default("[]")
  syncStatus    String                   @default("idle")
  lastSyncAt    DateTime?
  lastSyncError String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  blocklist     CalendarBlocklistEntry[]

  @@index([userId])
}

/// One expanded calendar instance (Chicago date) tied to a subscription. Status: active blocks; deleted user-removed; purgatory reappeared on manual sync after delete.
model CalendarBlocklistEntry {
  id               String               @id @default(cuid())
  subscriptionId   String
  subscription     CalendarSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  icsUid           String
  recurrenceId     String               @default("")
  instanceStartUtc DateTime
  dateKeyChicago   String
  note             String?
  status           String               @default("active")

  @@unique([subscriptionId, icsUid, recurrenceId, instanceStartUtc])
  @@index([subscriptionId])
  @@index([dateKeyChicago])
}

/// Per-user blackout rules (calendar-day granularity). `leagueScopes` JSON array; empty = all leagues.
model BlackoutRule {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceKind String
  oneOffDate     DateTime? @db.Date
  weekday        Int?
  monthOrdinal   Int?
  leagueScopes   Json      @default("[]")
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}
